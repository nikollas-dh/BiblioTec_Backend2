{
  "openapi": "3.1.1",
  "info": {
    "title": "BiblioTecApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7119"
    },
    {
      "url": "http://localhost:5183"
    }
  ],
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Livro": {
      "post": {
        "tags": [
          "Livro"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LivroCadastroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LivroCadastroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LivroCadastroDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Livro"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Usuario": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Formatolivro": {
        "type": "integer"
      },
      "GeneroLivro": {
        "type": "integer"
      },
      "LivroCadastroDto": {
        "required": [
          "titulo",
          "autor",
          "generoLivro",
          "editora",
          "formatoLivro"
        ],
        "type": "object",
        "properties": {
          "titulo": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "autor": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "generoLivro": {
            "$ref": "#/components/schemas/GeneroLivro"
          },
          "editora": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "anoPublicacao": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isbn": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "idioma": {
            "maxLength": 2,
            "minLength": 2,
            "type": "string"
          },
          "formatoLivro": {
            "$ref": "#/components/schemas/Formatolivro"
          },
          "caminhoCapa": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "sinopse": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "LoginRequestDto": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      },
      "Perfil": {
        "type": "integer"
      },
      "UsuarioCadastroDto": {
        "required": [
          "nome",
          "email",
          "senha",
          "data_nascimento",
          "celular",
          "cursoId",
          "perfil"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date-time"
          },
          "celular": {
            "pattern": "^\\d{11}",
            "type": "string"
          },
          "cursoId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Livro"
    },
    {
      "name": "Usuario"
    }
  ]
}