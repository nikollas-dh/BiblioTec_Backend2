{
  "openapi": "3.1.1",
  "info": {
    "title": "BiblioTecApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7119"
    },
    {
      "url": "http://localhost:5183"
    }
  ],
  "paths": {
    "/api/Usuario": {
      "post": {
        "tags": [
          "Usuario"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioCadastroDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Perfil": {
        "type": "integer"
      },
      "UsuarioCadastroDto": {
        "required": [
          "nome",
          "email",
          "senha",
          "data_nascimento",
          "celular",
          "cursoId",
          "perfil"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date-time"
          },
          "celular": {
            "pattern": "^\\d{11}",
            "type": "string"
          },
          "cursoId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "perfil": {
            "$ref": "#/components/schemas/Perfil"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Usuario"
    }
  ]
}